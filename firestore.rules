rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio live content document
    match /portfolio/{document=**} {
      // Anyone can read portfolio content (public website visitors)
      allow read: if true;
      // Anyone authenticated or updating via client app (can also be locked to auth users)
      allow write: if true;
    }
  }
}
